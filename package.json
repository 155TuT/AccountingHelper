{
  "name": "accounting-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ledger": "vitest run src/domain/ledger/ledger.test.ts",
    "test:currency": "vitest run src/domain/currency",
    "test:categories": "vitest run src/domain/ledger/categories.test.ts src/infrastructure/storage/category-storage.test.ts",
    "test:storage": "vitest run src/infrastructure/storage/storage.test.ts test/robustness.test.ts",
    "test:workspace": "vitest run src/features/ledger/workspace.test.ts",
    "test:integration": "vitest run test/acceptance.test.ts test/integration.test.ts",
    "test:ui": "vitest run src/features/entries/ui.test.tsx"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
